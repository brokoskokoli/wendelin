<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Only what the M1 integrations need; requested at runtime only when the
         user enables the integration (calendar). -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- mDNS search for Home Assistant in the Wi-Fi (MulticastLock, WP91) -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE"/>
    <!-- Routing condition „network“ (offline → local model), ConnectivityManager. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <!-- Warning about a failed TEE check after the answer (WP52, GPU mode „Nachher“): asked when
         the user chooses that mode. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.READ_CALENDAR"/>
    <uses-permission android:name="android.permission.WRITE_CALENDAR"/>
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM"/>
    <!-- Voice input (WP17): asked on first use, after an explanation. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <!-- Asks to exempt the app from battery optimization (WP56; no Play Store, K7). The system
         dialog decides; without it the assistant can fail to start after a long idle time. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"/>
    <!-- Wake word (WP50, ADR 0013): foreground service of type microphone with a permanent
         notification; a partial wake lock keeps the detection running with the screen off.
         No boot receiver: after a restart only the assistant role starts it. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <application
        android:label="Wendelin"
        android:name="${applicationName}"
        android:allowBackup="false"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Assistant overlay (half-height sheet over other apps and the lock screen). Started
             only by WendelinVoiceSession; own task, not in recents. -->
        <activity
            android:name=".AssistantActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity="app.wendelin.assistant"
            android:excludeFromRecents="true"
            android:theme="@style/AssistantTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize" />
        <!-- Standard assistant (long press on the power button, assistant gesture). Bound only by
             the system (BIND_VOICE_INTERACTION). -->
        <service
            android:name=".WendelinVoiceInteractionService"
            android:label="Wendelin"
            android:permission="android.permission.BIND_VOICE_INTERACTION"
            android:exported="true">
            <meta-data
                android:name="android.voice_interaction"
                android:resource="@xml/voice_interaction_service" />
            <intent-filter>
                <action android:name="android.service.voice.VoiceInteractionService" />
            </intent-filter>
        </service>
        <service
            android:name=".WendelinVoiceSessionService"
            android:permission="android.permission.BIND_VOICE_INTERACTION"
            android:exported="true" />
        <!-- Wake word listener (WP50): never exported; started by the app, the assistant service
             and its own notification. -->
        <service
            android:name=".WakeWordService"
            android:foregroundServiceType="microphone"
            android:exported="false" />
        <!-- System speech recognizer for other apps (local Whisper, WP20/ADR 0008); Android
             also requires it for an assistant. Disabled until Wendelin holds the assistant role
             and the user offers it (RecognizerSwitch), so installing the app never makes it the
             system speech recognizer (ADR 0006). -->
        <service
            android:name=".WendelinRecognitionService"
            android:label="Wendelin"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.speech.RecognitionService" />
            </intent-filter>
            <meta-data
                android:name="android.speech"
                android:resource="@xml/recognition_service" />
        </service>
        <!-- OAuth redirect of MCP servers (WP27): app.wendelin://oauth/mcp. Exported so the browser
             can open it; it only hands the address to a running login, which checks state. -->
        <activity
            android:name=".OAuthRedirectActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="app.wendelin" android:host="oauth" android:path="/mcp" />
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <!-- Vendor power settings (WP56, BatteryVendors): visible so resolveActivity works. -->
        <package android:name="com.miui.securitycenter"/>
        <package android:name="com.miui.powerkeeper"/>
        <package android:name="com.samsung.android.lool"/>
        <package android:name="com.oneplus.security"/>
        <package android:name="com.huawei.systemmanager"/>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Clock apps for the alarm integration (AlarmClock intents). -->
        <intent>
            <action android:name="android.intent.action.SET_ALARM"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.SET_TIMER"/>
        </intent>
        <!-- Apps of integrations (WP25, app detection): only these packages are visible to
             PackageManager, no QUERY_ALL_PACKAGES. Bring! (shopping list fallback), Obsidian
             (open notes), Spotify (later). Keep in step with KnownApps in
             lib/di/app_requirements.dart. -->
        <package android:name="ch.publisheria.bring"/>
        <package android:name="md.obsidian"/>
        <package android:name="com.spotify.music"/>
        <!-- Speech recognizers: name of the service Android gives other apps (B12, only read). -->
        <intent>
            <action android:name="android.speech.RecognitionService"/>
        </intent>
        <!-- Browsers for the OAuth login of MCP servers (WP27): Custom Tabs, else any browser. -->
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
        <!-- Installed TTS engines for the system voice (flutter_tts, K7). -->
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE"/>
        </intent>
    </queries>
</manifest>
