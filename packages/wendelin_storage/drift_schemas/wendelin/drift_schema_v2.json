    {
      "name": "memory_entries_ai",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TRIGGER memory_entries_ai AFTER INSERT ON memory_entries BEGIN INSERT INTO memory_fts (entry_id, body) VALUES (new.id, new.body);END"
        }
      ]
